From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Fri, 30 Oct 2026 22:00:00 +0000
Subject: [PATCH] PS5: report first and live SPU gateway coverage

Observe cumulative task/gateway/cpu_work entries and live inclusive ages
without waiting for the 256th gateway to return. Time every native JIT
gateway, not every guest block. Sample the first accepted cpu_work and
then each 1024th call, independently of the existing iteration counter.
Clear unfinished cpu_work samples when g_escape restores the native
stack; never use C++ RAII across the nonlocal escape. Report registered
slots even without completed samples, plus zero-ID registration failures.
No JIT instructions, emulation timing, guest state or FIFO policy changed.
Live age includes nested helpers and waits; it is not CPU duty cycle.

---
diff --git a/rpcs3/Emu/Cell/SPUThread.cpp b/rpcs3/Emu/Cell/SPUThread.cpp
--- a/rpcs3/Emu/Cell/SPUThread.cpp
+++ b/rpcs3/Emu/Cell/SPUThread.cpp
@@ -1556,7 +1556,7 @@
 #ifdef __PROSPERO__
 	// Existing guest SPU thread ID (not an OS thread ID).
 	const auto ps5_spu_slot = ps5_worker_activity::register_spu(lv2_id);
-	std::uint32_t ps5_spu_gateway_sample = 0;
+	ps5_worker_activity::begin_task(ps5_spu_slot, jit != nullptr);
 #endif
 	if (jit)
 	{
@@ -1576,20 +1576,12 @@
 			}
 
 #ifdef __PROSPERO__
-			// One sampled gateway call per 256. Includes any JIT helper
-			// waits; this is not guest instruction execution-only timing.
-			if (ps5_spu_slot && (++ps5_spu_gateway_sample & 255u) == 0u)
-			{
-				const auto sample_start = utils::get_tsc();
-				spu_runtime::g_gateway(*this, _ptr<u8>(0), nullptr);
-				ps5_worker_activity::record(ps5_spu_slot,
-					ps5_worker_activity::stage::spu_gateway, sample_start);
-			}
-			else
+			const auto ps5_gateway_start = ps5_worker_activity::begin_gateway(ps5_spu_slot);
 #endif
-			{
-				spu_runtime::g_gateway(*this, _ptr<u8>(0), nullptr);
-			}
+			spu_runtime::g_gateway(*this, _ptr<u8>(0), nullptr);
+#ifdef __PROSPERO__
+			ps5_worker_activity::end_gateway(ps5_spu_slot, ps5_gateway_start);
+#endif
 		}
 
 		if (unsavable && is_stopped(state - cpu_flag::stop))
@@ -1638,8 +1630,7 @@
 
 	const u32 old_iter_count = cpu_work_iteration_count++;
 #ifdef __PROSPERO__
-	const bool ps5_sample_mfc = ((old_iter_count & 1023u) == 0u);
-	const auto ps5_cpu_work_start = ps5_sample_mfc ? utils::get_tsc() : 0;
+	const auto ps5_work_probe = ps5_worker_activity::begin_cpu_work(lv2_id);
 #endif
 
 	bool work_left = false;
@@ -1724,15 +1715,8 @@
 	}
 
 #ifdef __PROSPERO__
-	if (ps5_sample_mfc)
-	{
-		// cached per-host-thread pointer; no scan on hot path.
-		static thread_local ps5_worker_activity::worker_slot* slot = nullptr;
-		if (!slot || slot->id.load(std::memory_order_relaxed) != lv2_id)
-			slot = ps5_worker_activity::register_spu(lv2_id);
-		ps5_worker_activity::record(slot,
-			ps5_worker_activity::stage::spu_cpu_work, ps5_cpu_work_start);
-	}
+	// Complete before g_escape bypasses the C++ stack below.
+	ps5_worker_activity::end_cpu_work(ps5_work_probe);
 #endif
 	if (gen_interrupt)
 	{
diff --git a/rpcs3/Emu/RSX/ps5_worker_activity.h b/rpcs3/Emu/RSX/ps5_worker_activity.h
--- a/rpcs3/Emu/RSX/ps5_worker_activity.h
+++ b/rpcs3/Emu/RSX/ps5_worker_activity.h
@@ -38,20 +38,34 @@
                        std::memory_order_relaxed, std::memory_order_relaxed)) {}
         }
     };
-    struct worker_slot
+    struct coverage_counters
+    {
+        std::atomic<std::uint64_t> tasks{0}, jit_tasks{0};
+        std::atomic<std::uint64_t> gateway_entries{0}, gateway_returns{0};
+        std::atomic<std::uint64_t> gateway_start{0};
+        std::atomic<std::uint64_t> cpu_work_entries{0}, cpu_work_start{0};
+        std::atomic<std::uint64_t> cpu_work_abandoned{0};
+    };
+    struct alignas(64) worker_slot
     {
         std::atomic<std::uint32_t> id{0};
         counters stats[2];
+        coverage_counters coverage;
     };
     inline worker_slot spu[64]{};
     inline counters rsx[stage_count]{};
     inline std::atomic<std::uint64_t> slot_overflow{0};
+    inline std::atomic<std::uint64_t> zero_id_registrations{0};
 
     // Resolve once when the SPU task begins; never perform this scan
     // in the JIT gateway or MFC hot path. lv2 IDs uniquely identify guests.
     inline worker_slot* register_spu(std::uint32_t id) noexcept
     {
-        if (!id) return nullptr;
+        if (!id)
+        {
+            zero_id_registrations.fetch_add(1, std::memory_order_relaxed);
+            return nullptr;
+        }
         for (auto& slot : spu)
         {
             auto found = slot.id.load(std::memory_order_relaxed);
@@ -75,6 +89,87 @@
             slot->stats[static_cast<unsigned>(kind)].record(end - start);
     }
 
+    // Coverage is independent of completed samples. In particular, the
+    // first gateway can remain active throughout the entire capture.
+    inline void begin_task(worker_slot* slot, bool jit) noexcept
+    {
+        if (!slot) return;
+        slot->coverage.tasks.fetch_add(1, std::memory_order_relaxed);
+        if (jit) slot->coverage.jit_tasks.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    inline std::uint64_t begin_gateway(worker_slot* slot) noexcept
+    {
+        if (!slot) return 0;
+        const auto start = utils::get_tsc();
+        slot->coverage.gateway_start.store(start, std::memory_order_release);
+        slot->coverage.gateway_entries.fetch_add(1, std::memory_order_relaxed);
+        return start;
+    }
+
+    inline void end_gateway(worker_slot* slot, std::uint64_t start) noexcept
+    {
+        if (!slot) return;
+        record(slot, stage::spu_gateway, start);
+        // g_escape restores the native stack without C++ unwinding. A
+        // sampled cpu_work may have been bypassed: never leave it active
+        // or falsely count that unfinished interval as a completed helper.
+        if (slot->coverage.cpu_work_start.exchange(0, std::memory_order_acq_rel))
+            slot->coverage.cpu_work_abandoned.fetch_add(1, std::memory_order_relaxed);
+        slot->coverage.gateway_returns.fetch_add(1, std::memory_order_relaxed);
+        slot->coverage.gateway_start.store(0, std::memory_order_release);
+    }
+
+    struct cpu_work_probe
+    {
+        worker_slot* slot = nullptr;
+        std::uint64_t start = 0;
+    };
+    inline cpu_work_probe begin_cpu_work(std::uint32_t id) noexcept
+    {
+        if (!id) return {};
+        // No per-call slot scan. A changed guest ID resolves a new slot.
+        static thread_local worker_slot* cached = nullptr;
+        if (!cached || cached->id.load(std::memory_order_relaxed) != id)
+            cached = register_spu(id);
+        if (!cached) return {};
+        const auto visit = cached->coverage.cpu_work_entries.fetch_add(1, std::memory_order_relaxed);
+        // Sample the FIRST accepted cpu_work, then every 1024 calls.
+        if (visit & 1023u) return {cached, 0};
+        const auto start = utils::get_tsc();
+        cached->coverage.cpu_work_start.store(start, std::memory_order_release);
+        return {cached, start};
+    }
+    inline void end_cpu_work(cpu_work_probe probe) noexcept
+    {
+        if (!probe.slot || !probe.start) return;
+        record(probe.slot, stage::spu_cpu_work, probe.start);
+        probe.slot->coverage.cpu_work_start.store(0, std::memory_order_release);
+    }
+
+    struct coverage_snapshot
+    {
+        std::uint64_t tasks, jit_tasks, gateway_entries, gateway_returns;
+        std::uint64_t gateway_active, gateway_age_tsc;
+        std::uint64_t cpu_work_entries, cpu_work_sample_active, cpu_work_sample_age_tsc;
+        std::uint64_t cpu_work_abandoned;
+    };
+    // Watchdog-only approximate snapshot: individual atomic fields are not
+    // a transaction. Ages are live inclusive wall time, never CPU duty cycle.
+    inline coverage_snapshot observe(const worker_slot& slot) noexcept
+    {
+        const auto& c = slot.coverage;
+        const auto gateway_start = c.gateway_start.load(std::memory_order_acquire);
+        const auto work_start = c.cpu_work_start.load(std::memory_order_acquire);
+        const auto now = utils::get_tsc();
+        return {c.tasks.load(std::memory_order_relaxed), c.jit_tasks.load(std::memory_order_relaxed),
+            c.gateway_entries.load(std::memory_order_relaxed), c.gateway_returns.load(std::memory_order_relaxed),
+            gateway_start != 0, gateway_start && now >= gateway_start ? now - gateway_start : 0,
+            c.cpu_work_entries.load(std::memory_order_relaxed), work_start != 0,
+            work_start && now >= work_start ? now - work_start : 0,
+            c.cpu_work_abandoned.load(std::memory_order_relaxed)};
+    }
+
     inline void record_rsx(stage kind, std::uint64_t start) noexcept
     {
         auto end = utils::get_tsc();
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -1045,6 +1045,20 @@
                     {
                         if (const u32 id = slot.id.load(std::memory_order_acquire))
                         {
+                            const auto coverage = ps5_worker_activity::observe(slot);
+                            const double gateway_age_us = clock_hz ? 1'000'000.0 * coverage.gateway_age_tsc / clock_hz : 0;
+                            const double work_age_us = clock_hz ? 1'000'000.0 * coverage.cpu_work_sample_age_tsc / clock_hz : 0;
+                            // Always report registered slots, even with no completed samples.
+                            // Counts are cumulative; live age must not be summed across windows.
+                            sys_log.notice("PS5 SPUCOVER: v2 id 0x%x tasks %llu jit_tasks %llu gateway_entries %llu gateway_returns %llu gateway_active %llu gateway_age_us %.3f cpu_work_entries %llu cpu_work_sample_active %llu cpu_work_sample_age_us %.3f cpu_work_abandoned %llu",
+                                id, static_cast<unsigned long long>(coverage.tasks),
+                                static_cast<unsigned long long>(coverage.jit_tasks),
+                                static_cast<unsigned long long>(coverage.gateway_entries),
+                                static_cast<unsigned long long>(coverage.gateway_returns),
+                                static_cast<unsigned long long>(coverage.gateway_active), gateway_age_us,
+                                static_cast<unsigned long long>(coverage.cpu_work_entries),
+                                static_cast<unsigned long long>(coverage.cpu_work_sample_active), work_age_us,
+                                static_cast<unsigned long long>(coverage.cpu_work_abandoned));
                             emit("spu", id, stage::spu_gateway, slot.stats[0]);
                             emit("spu", id, stage::spu_cpu_work, slot.stats[1]);
                         }
@@ -1052,6 +1066,9 @@
                     for (unsigned kind = static_cast<unsigned>(stage::rsx_fifo_running);
                          kind < static_cast<unsigned>(stage::count); ++kind)
                         emit("rsx", 0, static_cast<stage>(kind), ps5_worker_activity::rsx[kind]);
+                    if (const auto zero = ps5_worker_activity::zero_id_registrations.exchange(0))
+                        sys_log.notice("PS5 SPUCOVER2: zero_id_registrations %llu",
+                            static_cast<unsigned long long>(zero));
                     if (const auto overflow = ps5_worker_activity::slot_overflow.exchange(0))
                         sys_log.notice("PS5 WORKER2: lost_spu_slot_allocations %llu",
                             static_cast<unsigned long long>(overflow));
