diff --git a/rpcs3/Emu/Cell/ps5_spu_reswait.h b/rpcs3/Emu/Cell/ps5_spu_reswait.h
new file mode 100644
--- /dev/null
+++ b/rpcs3/Emu/Cell/ps5_spu_reswait.h
@@ -0,0 +1,114 @@
+#pragma once
+// PS5 diagnostic only: sample CPU vs elapsed time at SPU reservation waits.
+// Only this sampler's own atomics/clocks are touched, never guest state.
+// sampled calls: 1/128 per host thread and event type; counts are exact
+// atomic increments, times represent sampled calls and are NOT exclusive.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <ctime>
+
+namespace ps5_spu_reswait
+{
+    enum class event : unsigned
+    {
+        callback,
+        atomic_wait,
+        callback_notify,
+        post_wait_notify,
+        count
+    };
+    constexpr unsigned sample_period = 128;
+    constexpr unsigned event_count = static_cast<unsigned>(event::count);
+
+    struct data
+    {
+        std::atomic<std::uint64_t> calls{0};
+        std::atomic<std::uint64_t> samples{0};
+        std::atomic<std::uint64_t> wall_ns{0};
+        std::atomic<std::uint64_t> cpu_ns{0};
+        std::atomic<std::uint64_t> wall_max_ns{0};
+    };
+    inline std::array<data, event_count> g_data{};
+
+    inline std::uint64_t ns(const timespec& t) noexcept
+    {
+        return static_cast<std::uint64_t>(t.tv_sec) * 1'000'000'000ull +
+            static_cast<std::uint64_t>(t.tv_nsec);
+    }
+
+    class scope
+    {
+        data* m_data;
+        timespec m_wall{};
+        timespec m_cpu{};
+        bool m_sampled = false;
+
+    public:
+        explicit scope(event e) noexcept
+            : m_data(&g_data[static_cast<unsigned>(e)])
+        {
+            // Per-thread first call and every 128th call. Incrementing
+            // this slot provides an *exact*, not sampling-extrapolated,
+            // invocation count at the cost of one relaxed atomic.
+            m_data->calls.fetch_add(1, std::memory_order_relaxed);
+            static thread_local std::uint32_t s_phase[event_count]{};
+            const unsigned index = static_cast<unsigned>(e);
+            if (((s_phase[index]++) & (sample_period - 1)) != 0)
+                return;
+            if (clock_gettime(CLOCK_MONOTONIC, &m_wall) != 0 ||
+                clock_gettime(CLOCK_THREAD_CPUTIME_ID, &m_cpu) != 0)
+                return;
+            m_sampled = true;
+        }
+
+        ~scope() noexcept
+        {
+            if (!m_sampled)
+                return;
+            timespec wall{}, cpu{};
+            if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu) != 0 ||
+                clock_gettime(CLOCK_MONOTONIC, &wall) != 0)
+                return;
+            const auto start_wall = ns(m_wall);
+            const auto start_cpu = ns(m_cpu);
+            const auto end_wall = ns(wall);
+            const auto end_cpu = ns(cpu);
+            const auto wall_delta = end_wall >= start_wall ? end_wall - start_wall : 0;
+            const auto cpu_delta = end_cpu >= start_cpu ? end_cpu - start_cpu : 0;
+            m_data->samples.fetch_add(1, std::memory_order_relaxed);
+            m_data->wall_ns.fetch_add(wall_delta, std::memory_order_relaxed);
+            m_data->cpu_ns.fetch_add(cpu_delta, std::memory_order_relaxed);
+            auto prev = m_data->wall_max_ns.load(std::memory_order_relaxed);
+            while (prev < wall_delta &&
+                   !m_data->wall_max_ns.compare_exchange_weak(
+                       prev, wall_delta, std::memory_order_relaxed))
+            {}
+        }
+
+        scope(const scope&) = delete;
+        scope& operator=(const scope&) = delete;
+    };
+
+    struct snapshot
+    {
+        std::uint64_t calls;
+        std::uint64_t samples;
+        std::uint64_t wall_ns;
+        std::uint64_t cpu_ns;
+        std::uint64_t wall_max_ns;
+    };
+
+    inline snapshot take(event e) noexcept
+    {
+        auto& x = g_data[static_cast<unsigned>(e)];
+        // Snapshots may straddle a worker's scoped destructor and are
+        // cumulative (not destructively reset). Compare deltas between
+        // successive 4-second reports to avoid losing in-flight work.
+        return {x.calls.load(std::memory_order_relaxed),
+                x.samples.load(std::memory_order_relaxed),
+                x.wall_ns.load(std::memory_order_relaxed),
+                x.cpu_ns.load(std::memory_order_relaxed),
+                x.wall_max_ns.load(std::memory_order_relaxed)};
+    }
+}
