From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Fri, 30 Oct 2026 02:34:00 +0000
Subject: [PATCH] PS5: make SPU narrow-store check use a scalar condition

The optional narrow-store equivalence checker compares reloaded 128-bit
SPU local-store data to the original inserted vector. LLVM's vector
ICmpEQ yields <16 x i1>, which cannot serve as the scalar condition
for CreateCondBr. Bitcast each 128-bit vector to i128 before comparing.

This only affects the optional checked narrow-store JIT path. Default
SPU compilation, guest clocks, and runtime config stay unchanged.

---
diff --git a/rpcs3/Emu/Cell/SPULLVMRecompiler.cpp b/rpcs3/Emu/Cell/SPULLVMRecompiler.cpp
index 01e592ae0..94f1f00d2 100644
--- a/rpcs3/Emu/Cell/SPULLVMRecompiler.cpp
+++ b/rpcs3/Emu/Cell/SPULLVMRecompiler.cpp
@@ -9842,7 +9842,11 @@ public:
 		raw.value = spu_mem_attr(m_ir->CreateLoad(get_type<u8[16]>(), _ptr(m_lsptr, addr)));
 		llvm::Value* reloaded = byteswap(raw).eval(m_ir);
 		llvm::Value* full = m_ir->CreateBitCast(rt, get_type<u8[16]>());
-		llvm::Value* ok = m_ir->CreateICmpEQ(reloaded, full);
+		// A vector ICmpEQ returns <16 x i1>, but a conditional branch needs
+		// one scalar i1. Compare the 128-bit quad as a single integer.
+		auto* quad = llvm::IntegerType::get(m_context, 128);
+		llvm::Value* ok = m_ir->CreateICmpEQ(
+			m_ir->CreateBitCast(reloaded, quad), m_ir->CreateBitCast(full, quad));
 		auto* bad = llvm::BasicBlock::Create(m_context, "", m_function);
 		auto* cont = llvm::BasicBlock::Create(m_context, "", m_function);
 		m_ir->CreateCondBr(ok, cont, bad, m_md_unlikely);
