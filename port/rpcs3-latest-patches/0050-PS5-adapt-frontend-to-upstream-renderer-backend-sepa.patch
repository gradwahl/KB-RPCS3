From 814ab9c626361ba7868c26720151929bb60dadae Mon Sep 17 00:00:00 2001
From: KB-RPCS3 local build <local-build@localhost>
Date: Thu, 29 Oct 2026 23:52:25 +0000
Subject: [PATCH] PS5: adapt frontend to upstream renderer backend separation

---
 rpcs3/Emu/RSX/Core/RSXRendererFactory.cpp | 6 +++---
 rpcs3/ps5/ps5_frontend.cpp                | 9 ++++-----
 rpcs3/ps5/ps5_gs_frame.h                  | 3 +++
 3 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/rpcs3/Emu/RSX/Core/RSXRendererFactory.cpp b/rpcs3/Emu/RSX/Core/RSXRendererFactory.cpp
index e93646e8d..8bb64aaf7 100644
--- a/rpcs3/Emu/RSX/Core/RSXRendererFactory.cpp
+++ b/rpcs3/Emu/RSX/Core/RSXRendererFactory.cpp
@@ -5,7 +5,7 @@
 #include "Emu/RSX/RSXThread.h"
 #include "Emu/RSX/Null/NullGSRender.h"
 
-#ifndef __APPLE__
+#if !defined(__APPLE__) && !defined(__PROSPERO__)
 #include "Emu/RSX/GL/GLGSRender.h"
 #endif
 
@@ -25,7 +25,7 @@ namespace rsx
 		switch (renderer)
 		{
 		case video_renderer::opengl:
-#if !defined(__APPLE__)
+#if !defined(__APPLE__) && !defined(__PROSPERO__)
 			return video_renderer::opengl;
 #else
 			[[fallthrough]];
@@ -46,7 +46,7 @@ namespace rsx
 	{
 		switch (resolve_render_backend_type(renderer))
 		{
-#if !defined(__APPLE__)
+#if !defined(__APPLE__) && !defined(__PROSPERO__)
 		case video_renderer::opengl:
 			return std::make_unique<GLGSRender>(ctx, display);
 #endif
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index 932614a75..42a0af4de 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -14,6 +14,7 @@
 #include "Emu/Cell/timers.hpp"
 #include "Emu/system_utils.hpp"
 #include "Emu/emu_callbacks.h"
+#include "Emu/RSX/Core/RSXRendererFactory.h"
 #include "Emu/vfs_config.h"
 #include "Emu/VFS.h"
 #include "Emu/IdManager.h"
@@ -263,16 +264,14 @@ void create_callbacks()
 		switch (const video_renderer type = g_cfg.video.renderer)
 		{
 		case video_renderer::null:
-			g_fxo->init<rsx::thread, named_thread<NullGSRender>>(ar);
-			break;
 		case video_renderer::vulkan:
-			g_fxo->init<rsx::thread, named_thread<VKGSRender>>(ar);
+			rsx::create_render_thread(ar);
 			break;
 		default:
 			fmt::throw_exception("PS5: unsupported video renderer %s", type);
 		}
 	};
-	callbacks.get_gs_frame = []() -> std::unique_ptr<GSFrameBase> { return std::make_unique<ps5_gs_frame>(); };
+	callbacks.get_gs_frame = []() -> std::unique_ptr<GSFrameBase> { return std::make_unique<ps5_gs_frame>(g_cfg.video.renderer.get()); };
 	callbacks.close_gs_frame = []() {};
 	callbacks.get_audio = []() -> std::shared_ptr<AudioBackend>
 	{
@@ -964,7 +963,7 @@ void start_watchdog()
 					last_guest = guest;
 					u64 vblank = 0;
 					if (rsx::thread* rsx = rsx::get_current_renderer())
-						vblank = rsx->vblank_count.load();
+						vblank = rsx->display_ctrl().get_vblank_count();
 					const double vblank_hz = last_vblank ? (vblank - last_vblank) * 1000.0 / window_ms : 0.0;
 					last_vblank = vblank;
 					sys_log.notice("PS5 TIMING: guest/host %.3f, vblank %.1f/s", guest_ratio, vblank_hz);
diff --git a/rpcs3/ps5/ps5_gs_frame.h b/rpcs3/ps5/ps5_gs_frame.h
index fd1eec4a2..cfdc54e26 100644
--- a/rpcs3/ps5/ps5_gs_frame.h
+++ b/rpcs3/ps5/ps5_gs_frame.h
@@ -11,7 +11,10 @@ void ps5_record_frame();             // ps5_frontend.cpp: per-frame timing for t
 
 class ps5_gs_frame final : public GSFrameBase
 {
+	video_renderer m_renderer;
 public:
+	explicit ps5_gs_frame(video_renderer type) : m_renderer(type) {}
+	video_renderer renderer() const override { return m_renderer; }
 	void close() override {}
 	void reset() override {}
 	bool shown() override { return true; }
