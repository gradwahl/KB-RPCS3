diff --git a/rpcs3/Emu/RSX/ps5_frame_trace.h b/rpcs3/Emu/RSX/ps5_frame_trace.h
new file mode 100644
index 000000000..a74b5af2a
--- /dev/null
+++ b/rpcs3/Emu/RSX/ps5_frame_trace.h
@@ -0,0 +1,117 @@
+// PS5-only sparse CPU timeline; captures overlapping pipeline activity, not GPU duration.
+// Records only one in 32 guest display-queue epochs and PPU waits over 500 us.
+// Fixed-size atomic ring: no logging or allocation on guest/renderer threads.
+#pragma once
+#ifdef __PROSPERO__
+#include <atomic>
+#include <cstdint>
+#include "util/tsc.hpp"
+#include "util/sysinfo.hpp"
+
+namespace ps5_frame_trace
+{
+    enum class event : unsigned
+    {
+        guest_queue_begin = 1,
+        guest_queue_end,
+        guest_flip,
+        rsx_present_begin,
+        rsx_present_end,
+        vk_acquire_begin,
+        vk_acquire_end,
+        vk_submit_begin,
+        vk_submit_end,
+        vk_present_begin,
+        vk_present_end,
+        vk_fence_begin,
+        vk_fence_end,
+        ppu_event_wait_begin,
+        ppu_event_wait_end,
+        ppu_flag_wait_begin,
+        ppu_flag_wait_end,
+        ppu_sema_wait_begin,
+        ppu_sema_wait_end,
+    };
+
+    inline constexpr std::uint64_t ring_size = 4096;
+    struct entry
+    {
+        std::atomic<std::uint64_t> seq{0};
+        std::atomic<std::uint64_t> tsc{0};
+        std::atomic<std::uint64_t> payload{0};
+    };
+    inline entry ring[ring_size];
+    inline std::atomic<std::uint64_t> written{0};
+    inline std::atomic<std::uint32_t> epoch{0};
+    inline std::atomic<bool> sampled{false};
+
+    inline void stamp(event kind, std::uint32_t arg, std::uint32_t frame, std::uint64_t tsc) noexcept
+    {
+        const std::uint64_t pos = written.fetch_add(1, std::memory_order_relaxed);
+        entry& item = ring[pos % ring_size];
+        item.seq.store(0, std::memory_order_release);
+        item.tsc.store(tsc, std::memory_order_relaxed);
+        item.payload.store((static_cast<std::uint64_t>(frame & 0xffffffu) << 40)
+            | (static_cast<std::uint64_t>(arg) << 8)
+            | static_cast<unsigned>(kind), std::memory_order_relaxed);
+        item.seq.store(pos + 1, std::memory_order_release);
+    }
+
+    inline void mark(event kind, std::uint32_t arg = 0) noexcept
+    {
+        if (!sampled.load(std::memory_order_relaxed)) return;
+        const auto frame = epoch.load(std::memory_order_relaxed);
+        stamp(kind, arg, frame, utils::get_tsc());
+    }
+
+    // Start a new sampled wall-time epoch at the PS3 guest's display queue syscall.
+    // The sampled epoch spans one queue-to-queue interval. It does not guarantee
+    // asynchronous GPU submissions belong to that particular guest frame.
+    inline void guest_queue(std::uint32_t buffer) noexcept
+    {
+        const auto next = epoch.fetch_add(1, std::memory_order_relaxed) + 1;
+        const bool enabled = (next % 32u == 0u);
+        sampled.store(enabled, std::memory_order_relaxed);
+        if (enabled) stamp(event::guest_queue_begin, buffer, next, utils::get_tsc());
+    }
+
+    // Longer guest PPU host waits only. Scoped after the immediate fast path has
+    // failed, so these represent actual time spent on the blocking path.
+    struct long_wait
+    {
+        const event kind;
+        const std::uint32_t arg;
+        const std::uint32_t frame;
+        const std::uint64_t started;
+        explicit long_wait(event k, std::uint32_t identifier) noexcept
+            : kind(k), arg(identifier),
+              frame(sampled.load(std::memory_order_relaxed)
+                        ? epoch.load(std::memory_order_relaxed) : 0),
+              started(frame ? utils::get_tsc() : 0) {}
+        ~long_wait() noexcept
+        {
+            if (!started) return;
+            const auto finished = utils::get_tsc();
+            const auto freq = utils::get_tsc_freq();
+            if (!freq || finished < started || finished - started < freq / 2000u) return;
+            stamp(kind, arg, frame, started);
+            stamp(static_cast<event>(static_cast<unsigned>(kind) + 1), arg, frame, finished);
+        }
+    };
+
+    struct record
+    {
+        std::uint64_t pos, tsc, payload;
+    };
+    inline bool read(std::uint64_t pos, record& out) noexcept
+    {
+        const entry& item = ring[pos % ring_size];
+        if (item.seq.load(std::memory_order_acquire) != pos + 1) return false;
+        const auto payload = item.payload.load(std::memory_order_relaxed);
+        const auto tsc = item.tsc.load(std::memory_order_relaxed);
+        if (item.seq.load(std::memory_order_acquire) != pos + 1) return false;
+        out = {pos, tsc, payload};
+        return true;
+    }
+}
+#endif
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index aa6021f10..03d1ade58 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -21,6 +21,7 @@
 #include "Emu/RSX/RSXThread.h"
 #ifdef __PROSPERO__
 #include "Emu/RSX/ps5_rsx_perf.h"
+#include "Emu/RSX/ps5_frame_trace.h"
 #endif
 #include "Emu/RSX/Null/NullGSRender.h"
 #include "Emu/RSX/VK/VKGSRender.h"
@@ -976,6 +977,48 @@ void start_watchdog()
 					sys_log.notice("PS5 TIMING: guest/host %.3f, vblank %.1f/s", guest_ratio, vblank_hz);
 				}
 				sys_log.notice("PS5 CPU: %s", ps5_thread_cpu_report(window_ms * 1'000'000, 14));
+
+#ifdef __PROSPERO__
+                // Sparse cross-thread CPU timeline: drain the fixed ring on the
+                // watchdog only. Never log or allocate on the guest/RSX threads.
+                // A sample epoch is a guest display-queue-to-queue interval,
+                // NOT proof that every asynchronous event belongs to its frame.
+                {
+                    static std::uint64_t cursor = 0;
+                    const auto end = ps5_frame_trace::written.load(std::memory_order_acquire);
+                    std::uint64_t skipped = 0, emitted = 0, missed = 0;
+                    const auto first = end > 256 ? end - 256 : 0;
+                    if (cursor < first)
+                    {
+                        skipped = first - cursor;
+                        cursor = first;
+                    }
+                    const auto freq = utils::get_tsc_freq();
+                    for (; cursor < end; ++cursor)
+                    {
+                        ps5_frame_trace::record record{};
+                        if (!ps5_frame_trace::read(cursor, record))
+                        {
+                            ++missed;
+                            continue;
+                        }
+                        const auto frame = static_cast<unsigned>((record.payload >> 40) & 0xffffffu);
+                        const auto arg = static_cast<unsigned>((record.payload >> 8) & 0xffffffffu);
+                        const auto kind = static_cast<unsigned>(record.payload & 0xffu);
+                        sys_log.notice("PS5 FRAMEDEP: seq %llu epoch %u kind %u arg %u tsc %llu",
+                            static_cast<unsigned long long>(record.pos),
+                            frame, kind, arg, static_cast<unsigned long long>(record.tsc));
+                        ++emitted;
+                    }
+                    if (emitted || skipped || missed)
+                        sys_log.notice("PS5 FRAMEDEP2: window %u ms emitted %llu skipped %llu missed %llu tsc_hz %llu total %llu",
+                            window_ms, static_cast<unsigned long long>(emitted),
+                            static_cast<unsigned long long>(skipped),
+                            static_cast<unsigned long long>(missed),
+                            static_cast<unsigned long long>(freq),
+                            static_cast<unsigned long long>(end));
+                }
+#endif
 #if defined(__PROSPERO__) && PS5_RSX_PERF_ACTIVE
 				{
 					using ps5_rsx_perf::stage;
