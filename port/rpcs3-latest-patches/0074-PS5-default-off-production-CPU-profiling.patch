+        if constexpr (!PS5_RELEASE_PROFILE_ACTIVE) return nullptr;
         if (!id)
         {
             zero_id_registrations.fetch_add(1, std::memory_order_relaxed);
             return nullptr;
@@ -137,9 +139,9 @@
