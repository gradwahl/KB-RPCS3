From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Sat, 31 Oct 2026 04:49:00 +0000
Subject: [PATCH] PS5: disable production CPU instrumentation by default

Keep watchdog SIGUSR2/heartbeats and tuning hot-reload active.
Default-off diagnostic mode disables per-thread SIGUSR1 CPU snapshots,
RSX histogram counters, SPU reservation/wakeup/worker samples, and
per-JIT function-name map allocations; opt-in retains all facilities.
No changes to native TLS flags, guest memory or JIT machine code.
---
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -28,8 +28,12 @@
 #include "Emu/Cell/ps5_spu_reswait.h"
 #include "Emu/Cell/ps5_spu_wakeup.h"
 #include "ps5_spu_hotjit.h"
 #include "ps5_cpu_topology.h"
+#include "ps5_release_profile.h"
+#if !PS5_RELEASE_PROFILE_ACTIVE && PS5_SPU_HOTJIT_ACTIVE
+#error SPU hot JIT profiler needs PS5_RELEASE_PROFILE_ACTIVE=1
+#endif
 #endif
 #include "Emu/RSX/Null/NullGSRender.h"
 #include "Emu/RSX/VK/VKGSRender.h"
 #include "Emu/Audio/Null/NullAudioBackend.h"
@@ -962,17 +966,20 @@
 #endif
 		u64 last_dump = 0;
 		u64 last_cpu = now_ms();
 		u64 cpu_reports = 0;
+#if PS5_RELEASE_PROFILE_ACTIVE
 		ps5_thread_cpu_report(1, 0); // start the CPU monitor's window
+#endif
 		sys_log.notice("PS5: TSC frequency %u Hz (0 = RPCS3 reads the OS clock, ~1 us per call on the console)", utils::get_tsc_freq());
 		while (g_watchdog_run)
 		{
 			std::this_thread::sleep_for(std::chrono::seconds(2));
 			const u64 now = now_ms();
 			// CPU monitor: each RPCS3 thread's share of a core over the last ~4 s (100% = one core)
 			if (now - last_cpu >= 4000)
 			{
+#if PS5_RELEASE_PROFILE_ACTIVE
 				// The window is measured at the report itself: the profile below takes 2 s of its own, and windows
 				// measured from before it read 1.5x too high (2026-10-08)
 				static u64 last_report = now_ms();
 				const u64 report_time = now_ms();
@@ -1344,8 +1351,29 @@
 						sys_log.notice("PS5 SPU HOTJIT: no active SPU execution thread");
 					}
 				}
 #endif
+#else
+                // Preserve live tuning refresh without CPU signals,
+                // sample snapshots, high-volume frame logging or any
+                // guest JIT/RSX trace drains in normal gameplay.
+                rpcs3ps5_tune_refresh();
+                static std::string previous_tuning = rpcs3ps5_tune_describe();
+                const std::string current_tuning = rpcs3ps5_tune_describe();
+                if (previous_tuning != current_tuning)
+                {
+                    previous_tuning = current_tuning;
+                    sys_log.notice("PS5 TUNING: %s", current_tuning);
+                }
+                // The experimental spu_hot_cpu scheduler relies on CPU
+                // SIGUSR1 samples. Do not silently pretend it can run.
+                static bool warned_hot_cpu = false;
+                if (!warned_hot_cpu && rpcs3ps5_tune(7) >= 0)
+                {
+                    warned_hot_cpu = true;
+                    sys_log.warning("PS5 HOTCPU requires an explicit diagnostics-enabled build; no CPU affinity changed");
+                }
+#endif
 				last_cpu = now_ms();
 			}
 			if (now - g_main_heartbeat > 20000 && now - last_dump > 30000)
 			{
