@@ -3196,9 +3197,9 @@
 
 	// Initialize TLS variables
 	thread_ctrl::g_tls_this_thread = this;
 
-#ifdef __PROSPERO__
+#if defined(__PROSPERO__) && PS5_RELEASE_PROFILE_ACTIVE
 	ps5_cpu_register(this, &m_tname);
 #endif
 
 	thread_ctrl::g_tls_error_callback = error_cb;
@@ -3276,9 +3277,9 @@
 }
 
 u64 thread_base::finalize(thread_state result_state) noexcept
 {
-#ifdef __PROSPERO__
+#if defined(__PROSPERO__) && PS5_RELEASE_PROFILE_ACTIVE
 	{
 		std::lock_guard lock(g_ps5_threads_mutex);
 		std::erase_if(g_ps5_threads, [this](const ps5_thread_entry& e) { return e.base == this; });
 		t_ps5_cpu_slot = nullptr;
