From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KB <kb@kb-rpcs3.example>
Date: Fri, 30 Oct 2026 01:00:00 +0000
Subject: [PATCH] PS5: resolve adapter aliases to the console GPU identity

The frontend alias differs from the driver device name. The new upstream
renderer change detector consequently rebuilt Vulkan on every loading-screen
flip. Resolve the single-GPU console identity to the device already in use,
while retaining backend change detection and desktop adapter selection.

---
diff --git a/rpcs3/Emu/RSX/VK/VKGSRender.cpp b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
index 73bb16d13..b51a95771 100644
--- a/rpcs3/Emu/RSX/VK/VKGSRender.cpp
+++ b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
@@ -917,11 +917,18 @@ std::string VKGSRender::configured_logical_id() const
 		return "";
 	}
 
+#ifdef __PROSPERO__
+	// The console has one GPU. The frontend's adapter alias (and names saved
+	// by older drivers) resolves to that GPU during initialization. Comparing
+	// that alias to the driver's name requests a renderer reset on every flip.
+	return logical_id();
+#else
 	// An empty adapter selects the default GPU, which is the one in use
 	const std::string adapter = g_cfg.video.vk.adapter.to_string();
 	return adapter.empty()
 		? logical_id()
 		: "Vulkan | " + adapter;
+#endif
 }
 
 bool VKGSRender::on_access_violation(rsx::context* ctx, u32 address, bool is_writing)
