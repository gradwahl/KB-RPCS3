@@ -924,8 +927,26 @@ namespace rsx
 				}
 			}
 
-			// Execute FIFO queue
-			run_FIFO();
+			// Execute FIFO queue. Sample one in 128 iterations, to avoid
+			// reading a clock for every guest FIFO command. Classify by
+			// resulting state: an approximation, not GPU/CPU overlap.
+#ifdef __PROSPERO__
+			if ((m_cycles_counter & 127) == 0)
+			{
+				const u64 start_ns = ps5_rsx_perf::now_ns();
+				run_FIFO();
+				const u64 end_ns = ps5_rsx_perf::now_ns();
+				ps5_rsx_perf::record(
+					performance_counters.state == FIFO::state::running
+						? ps5_rsx_perf::stage::fifo_running_sample
+						: ps5_rsx_perf::stage::fifo_idle_sample,
+					end_ns >= start_ns ? end_ns - start_ns : 0);
+			}
+			else
+#endif
+			{
+				run_FIFO();
+			}
 		}
 	}
 
