diff --git a/rpcs3/Emu/RSX/ps5_rsx_perf.h b/rpcs3/Emu/RSX/ps5_rsx_perf.h
new file mode 100644
index 000000000..edb1895e5
--- /dev/null
+++ b/rpcs3/Emu/RSX/ps5_rsx_perf.h
@@ -0,0 +1,82 @@
+// PS5-only RSX diagnostic counters. No emulation decisions depend on these.
+// Each counter is a cumulative CPU-side wall time; categories may nest.
+// FIFO timings are sampled every 128 main-loop iterations and must not be
+// interpreted as an exact per-frame critical-path or GPU execution time.
+#pragma once
+
+#ifdef __PROSPERO__
+#include <atomic>
+#include <cstdint>
+#include <time.h>
+
+namespace ps5_rsx_perf
+{
+    enum class stage : unsigned
+    {
+        fifo_running_sample,
+        fifo_idle_sample,
+        vertex_upload,
+        index_convert,
+        dma_sync,
+        vk_close_submit,
+        vk_queue_submit,
+        count
+    };
+
+    struct counters
+    {
+        std::atomic<std::uint64_t> ns{0};
+        std::atomic<std::uint64_t> calls{0};
+        std::atomic<std::uint64_t> bytes{0};
+    };
+
+    inline counters g_stages[static_cast<unsigned>(stage::count)];
+
+    inline std::uint64_t now_ns() noexcept
+    {
+        struct timespec ts{};
+        ::clock_gettime(CLOCK_MONOTONIC, &ts);
+        return static_cast<std::uint64_t>(ts.tv_sec) * 1000000000ull +
+               static_cast<std::uint64_t>(ts.tv_nsec);
+    }
+
+    inline void record(stage which, std::uint64_t elapsed, std::uint64_t bytes = 0) noexcept
+    {
+        auto& value = g_stages[static_cast<unsigned>(which)];
+        value.ns.fetch_add(elapsed, std::memory_order_relaxed);
+        value.calls.fetch_add(1, std::memory_order_relaxed);
+        value.bytes.fetch_add(bytes, std::memory_order_relaxed);
+    }
+
+    struct timer
+    {
+        const stage which;
+        const std::uint64_t start;
+        std::uint64_t transferred_bytes;
+        explicit timer(stage value, std::uint64_t bytes = 0) noexcept
+            : which(value), start(now_ns()), transferred_bytes(bytes) {}
+        timer(const timer&) = delete;
+        timer& operator=(const timer&) = delete;
+        ~timer() noexcept
+        {
+            const auto end = now_ns();
+            record(which, end >= start ? end - start : 0, transferred_bytes);
+        }
+    };
+
+    struct sample
+    {
+        std::uint64_t ns;
+        std::uint64_t calls;
+        std::uint64_t bytes;
+    };
+
+    inline sample take(stage which) noexcept
+    {
+        auto& value = g_stages[static_cast<unsigned>(which)];
+        return { value.ns.exchange(0, std::memory_order_relaxed),
+                 value.calls.exchange(0, std::memory_order_relaxed),
+                 value.bytes.exchange(0, std::memory_order_relaxed) };
+    }
+}
+#endif
diff --git a/rpcs3/ps5/ps5_frontend.cpp b/rpcs3/ps5/ps5_frontend.cpp
index 42a0af4de..57430c8bb 100644
--- a/rpcs3/ps5/ps5_frontend.cpp
+++ b/rpcs3/ps5/ps5_frontend.cpp
@@ -19,6 +19,9 @@
 #include "Emu/VFS.h"
 #include "Emu/IdManager.h"
 #include "Emu/RSX/RSXThread.h"
+#ifdef __PROSPERO__
+#include "Emu/RSX/ps5_rsx_perf.h"
+#endif
 #include "Emu/RSX/Null/NullGSRender.h"
 #include "Emu/RSX/VK/VKGSRender.h"
 #include "Emu/Audio/Null/NullAudioBackend.h"
@@ -969,6 +972,28 @@ void start_watchdog()
 					sys_log.notice("PS5 TIMING: guest/host %.3f, vblank %.1f/s", guest_ratio, vblank_hz);
 				}
 				sys_log.notice("PS5 CPU: %s", ps5_thread_cpu_report(window_ms * 1'000'000, 14));
+#ifdef __PROSPERO__
+				{
+					using ps5_rsx_perf::stage;
+					const auto active = ps5_rsx_perf::take(stage::fifo_running_sample);
+					const auto idle = ps5_rsx_perf::take(stage::fifo_idle_sample);
+					const auto vertex = ps5_rsx_perf::take(stage::vertex_upload);
+					const auto index = ps5_rsx_perf::take(stage::index_convert);
+					const auto dma = ps5_rsx_perf::take(stage::dma_sync);
+					const auto close = ps5_rsx_perf::take(stage::vk_close_submit);
+					const auto submit = ps5_rsx_perf::take(stage::vk_queue_submit);
+					// Timings are CPU wall time, not GPU runtime; stages nest.
+					// FIFO samples are one in 128 loop iterations; do not
+					// divide by frame count or treat as exact RSX busy %.
+					sys_log.notice("PS5 PERF: window %u ms | FIFO sampled running %u calls %u us idle %u calls %u us | vertex %u calls %u us | index %u calls %u KiB %u us | dma_sync %u calls %u us | vk_close %u calls %u us | vk_submit %u calls %u us",
+						window_ms,
+						active.calls, active.ns / 1000, idle.calls, idle.ns / 1000,
+						vertex.calls, vertex.ns / 1000,
+						index.calls, index.bytes / 1024, index.ns / 1000,
+						dma.calls, dma.ns / 1000, close.calls, close.ns / 1000,
+						submit.calls, submit.ns / 1000);
+				}
+#endif
 				ps5_hot_spu_rebalance(rpcs3ps5_tune(7)); // PS5_TUNE_SPU_HOT_CPU
 				sys_log.notice("PS5 JIT verify: %llu failures", static_cast<unsigned long long>(rpcs3ps5_jit_verify_failures()));
 				sys_log.notice("PS5 NARROW CHECK: %llu mismatches", static_cast<unsigned long long>(rpcs3ps5_narrow_ls_check_failures()));
